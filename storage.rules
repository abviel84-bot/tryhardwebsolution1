rules_version = '2';

// ============================================================
//  TRYHARD WEB SOLUTION — Reglas de Firebase Storage (fotos/videos)
//  Pega esto en: Firebase Console → Storage → Reglas
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /site-images/{allPaths=**} {
      // Cualquiera puede VER las fotos del sitio
      allow read: if true;

      // Solo el administrador autenticado puede subir/borrar fotos
      allow write: if request.auth != null
        && request.auth.token.email == "admin@tryhardwebsolution.com"
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
